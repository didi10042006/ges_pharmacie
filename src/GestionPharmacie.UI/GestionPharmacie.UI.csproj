<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Métadonnées d'assemblage et Open Source -->
    <AssemblyTitle>Système de Gestion de Pharmacie Officinale</AssemblyTitle>
    <Product>Gestion Pharmacie</Product>
    <Authors>Dzaba Diliane Merveille</Authors>
    <Company>Dzaba Diliane Merveille</Company>
    <Copyright>Copyright © 2026 Dzaba Diliane Merveille. Sous licence MIT.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Logiciel open source de gestion d'officine pharmaceutique (WinForms C# .NET 8, SQLite, traçabilité des lots FIFO).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionPharmacie.Models\GestionPharmacie.Models.csproj" />
    <ProjectReference Include="..\GestionPharmacie.BLL\GestionPharmacie.BLL.csproj" />
    <ProjectReference Include="..\GestionPharmacie.DAL\GestionPharmacie.DAL.csproj" />
  </ItemGroup>

</Project>